class HANDLER:
    'Class for device handler objects'

    # Available capabilities
    cap_dict = dict(k = "keyboard",
                    T = "tablet",
                    t = "touch", # in actions
                    p = "pointer", # match to gesture too ? or disregard because we don't want simple pointers ?
                    g = "gesture", # in actions
                    S = "switch") # in actions

    def __init__(self, device):
        'Initialize a device handler'
        self.device = device
        self.LISTENERS = dict(DEVICE  = self.listener_device,
                              TOUCH   = self.listener_touch,
                              GESTURE = self.listener_gesture,
                              SWITCH  = self.listener_switch,
                              POINTER = self.listener_pointer)
        self.enabled = True

    def add(self, name, capabilities, sizex, sizey):
        'Populate handler parameters and decide if it\'s enabled'
        self.name = name
        self.capabilities = {v for k, v in self.cap_dict.items() if k in list(capabilities)}
        self.size = (sizex, sizey)

        self.release()

        # If no action relevant, disable handler
        self.enabled = True if {k:v for k, v in actions.actions.items() if k in self.capabilities} else False

        return {'verbose': f'{'Adding  ' if self.enabled else 'Ignoring'} device {name:50} ({self.device}) {self.capabilities}'}

    def remove(self):
        'Remove the handler for an unplugged device'
        del(handler[self.device])
        return {'verbose': f'Removing device  {self.name:50} ({self.device})'}

    def grab(self, device_type, time = None):
        'Grab a handler and set its current device type, the focused window class, and the starting time'
        self.busy = True

        self.wclass = subprocess.run(['xdotool', 'getwindowfocus', 'getwindowclassname'], capture_output = True).stdout.decode('utf-8').strip()
        self.start_time = time
        self.path = [device_type]

    def release(self, message = None):
        'Release a handler and reset its state'
        self.busy = False
        self.holding = False
        self.chaining = False
        self.pre = False

        self.data = dict(x = 0, y = 0, dx = 0, dy = 0, ratio = 0, dratio = 0, angle = 0, dangle = 0)

        self.path = []
        self.start_time = None
        self.gesture = None
        self.motion = None
        self.wclass = None
        self.available_motions = None
        self.available_actions = None

        return {'verbose': message} if message else None

    def extend_path(self, *items):
        'Extend the action path and validate it'
        self.path.extend(items)
        return actions.validate_path(self.path)

    def run(self, command = None, *items):
        'Run the given command or the one at the end of path + *items'
        if not command:
            valid, res = self.extend_path(*items)
            if not valid:
                return self.release(f'No path to action from {res} in {self.path}. Releasing handler')
            else:
                command = res

        # Replace {} in commands
        data = {k: int(v) for k, v in self.data.items()}
        exprs = re.findall(r'\{[^\{\}]+\}', command)
        for expr in exprs:
            command = command.replace(expr, str(eval(expr[1:-1], {}, data)))

        if args.verbose:
            print(f'{self.path} {data}')
            print('  ', command)
            print('')

        if not args.debug:
            run(shlex.split(command))

        return None

    def switch(self, switch, state):
        'Handle a switch action'
        if self.busy:
            return {'debug': f'Handler for device {self.device} is in use (shouldn\'t be possible!)'}

        self.grab('switch')

        res = self.run(switch, state)

        return res if res else self.release()

    def hold(self, device_type, event, time, fingers, cancelled):
        'Handle a hold action'
        if event == 'BEGIN':
            if self.busy:
                return self.release(f'Handler for device {self.device} is in use (shouldn\'t be possible!)')

            self.grab(device_type, time)
            valid, res = self.extend_path(fingers, 'hold')

            if not valid:
                return self.release(f'No path to action from {res} in {self.path}. Releasing handler')
            else:
                # use a realtime timer to run 'pre' action
                pass

        elif event == 'END':
            if not self.busy:
                return {'verbose': 'Not listening to HOLD event end here'}

            if time - self.start_time > options.hold_min_threshold:
                if not cancelled:
                    valid, res = self.extend_path(None)
                    if not valid:
                        return self.release(f'No path to action from {res} in {self.path}. Releasing handler')

                    self.available_actions = res[self.wclass] if self.wclass in list(res) else res[None]
                    if 'end' in list(self.available_actions):
                        self.run(command = self.available_actions['end'])

                    self.release()
                else:
                    # This will be hold+gestures
                    # Don't remove handler and set a flag: self.holding = True
                    return self.release()
            else:
                return self.release()

    def begin(self, device_type, gesture, time, fingers):
        'Handle the begin event of all other actions'
        if self.busy and not self.holding:
            return self.release(f'Handler for device {self.device} is busy (shouldn\'t be possible!)')

        self.grab(device_type, time)

        valid, res = self.extend_path(fingers)
        if not valid:
            return self.release(f'No path to action from {res} in {self.path}. Releasing handler')

        # Get gestures that can trigger actions
        self.available_gestures = {k for k, v in res.items() if not {self.wclass, None}.isdisjoint(v['apps'])}

        # Skip if only HOLD gestures registered
        if self.available_gestures == ['HOLD']:
            return self.release(f'No gesture with {fingers} fingers registered for device {self.device}. Releasing handler')

        # Skip if libinput says the gesture is a swipe and there's no swipe action
        if gesture == 'SWIPE':
            if 'swipe' in self.available_gestures:
                self.gesture = 'swipe'
            else:
                return self.release(f'No swipe gesture with {fingers} fingers registered. Releasing handler')

    def update(self, time, fingers, x, y, ratio, angle):
        'Handle the update event of all other actions'
        if not self.busy:
            return {'verbose': 'Not listening to update events for this gesture'}

        # Update handler data
        if ratio:
            ratio = math.log(float(ratio))
            angle = float(angle)
            self.data['dratio'] = ratio - self.data['dratio']
            self.data['ratio'] = ratio
            self.data['dangle'] += angle
            self.data['angle'] += angle

        if x:
            x = float(x)
            y = float(y)
            self.data['x'] += x
            self.data['dx'] += x
            self.data['y'] += y
            self.data['dy'] += y

        x, y, dx, dy, ratio, dratio, angle, dangle = self.data.values()

        # Determine gesture within available gestures
        if not self.gesture:
            self.gesture = 'rotate' if 'rotate' in self.available_gestures and abs(angle) > options.angle_min_threshold \
                     else  'pinch'  if 'pinch'  in self.available_gestures and abs(ratio) > options.ratio_min_threshold \
                     else  'swipe'  if 'swipe'  in self.available_gestures and math.sqrt(x ** 2 + y ** 2) > options.swipe_min_threshold \
                else None

        # Get available motions
        if self.gesture and not self.available_motions:
            _, res = self.extend_path(self.gesture)
            self.available_motions = {k for k, v in res.items() if (not {self.wclass, None}.isdisjoint(list(v)) and k != 'apps')}

        # Determine gesture motion
        if self.available_motions and not self.motion:
            self.motion = 'up'    if 'up' in self.available_motions and abs(y) > abs(x) and y < 0 \
                     else 'down'  if 'down' in self.available_motions and abs(y) > abs(x) and y > 0 \
                     else 'left'  if 'left' in self.available_motions and abs(x) > abs(y) and x < 0 \
                     else 'right' if 'right' in self.available_motions and abs(x) > abs(y) and x > 0 \
                     else 'in'    if 'in' in self.available_motions and ratio < 0 \
                     else 'out'   if 'out' in self.available_motions and ratio > 0 \
                     else 'cw'    if 'cw' in self.available_motions and angle > 0 \
                     else 'ccw'   if 'ccw' in self.available_motions and angle < 0 \
                     else None

        # Register motion only if over *_chain_threshold
        if self.chaining and \
            ((self.gesture == 'swipe' and math.sqrt(x ** 2 + y ** 2) < options.swipe_chain_threshold) or \
             (self.gesture == 'pinch' and abs(ratio) < options.ratio_chain_threshold) or \
             (self.gesture == 'rotate' and abs(angle) < options.angle_chain_threshold)):
            self.motion = None

        # Get available actions
        if self.motion and not self.available_actions:
            _, res = actions.validate_path([*self.path, self.motion])
            self.available_actions = res[self.wclass] if self.wclass in list(res) else res[None]

        # Run early actions (pre, chain, continuous)
        if self.available_actions:
            if self.chaining and 'chain' not in self.available_actions:
                self.motion = None
                self.available_actions = None
                return

            if 'pre' in list(self.available_actions) and not self.pre:
                self.run(command = self.available_actions['pre'])
                self.pre = True

            if 'continuous' in list(self.available_actions) and time - self.start_time > options.update_timer:
                self.run(command = self.available_actions['continuous'])
                self.start_time = time
                self.data['dx'] = 0
                self.data['dy'] = 0
                self.data['dangle'] = 0
                self.data['dratio'] = 0

            if 'chain' in list(self.available_actions):
                self.run(command = self.available_actions['chain'])
                # run for hold+ : gesture is added to path and then motion/wclass/modifier
                self.chaining = True
                self.motion = None
                self.available_actions = None
                self.data = dict(x = 0, y = 0, dx = 0, dy = 0, angle = 0, ratio = 0, dangle = 0, dratio = 0)

    def end(self, cancelled):
        'Handle end event for all actions'
        if not self.busy:
            return self.release(f'Skipping end for device {self.device} as there isn\'t anything to do with it')

        # Run late actions (end, post)
        if self.available_actions:
            if 'end' in list(self.available_actions) and not cancelled:
                self.run(command = self.available_actions['end'])

            if 'post' in list(self.available_actions):
                self.run(command = self.available_actions['post'])

        return self.release()

    def parse(self, event, time, params):
        'Parse a libinput line and dispatch to the relevant listener'
        time = time and float(time)
        event = event.split('_')

        # Skip the event if the device is disabled, not supported, or empty
        if not self.enabled or not params_re.get(event[0]) or not params:
            return

        fields = params_re[event[0]].match(params)

        if not fields:
            if args.debug:
                print(f'Error parsing event {event[0]} params: {params}', file = sys.stderr)
            return

        fields = fields.groupdict()

        if args.raw:
            print(f'Parsed event: {fields}')

        # Dispatch to the relevant listener
        answer = self.LISTENERS[event[0]](event[1:], time, **fields)
        if answer:
            if args.debug and 'debug' in list(answer):
                print(answer['debug'], file = sys.stderr)
            if args.verbose and 'verbose' in list(answer):
                print(answer['verbose'])

    def listener_device(self, event, time, name, seat, group, capabilities, sizex, sizey):
        'Listener for DEVICE lines'
        if event[0] == 'ADDED':
            return self.add(name, capabilities, sizex, sizey)
        elif event[0] == 'REMOVED':
            return self.remove()
        else:
            return {'debug': f'Device event {event} not recognized'}

    def listener_switch(self, event, time, switch, state):
        'Listener for SWITCH lines'
        if event[0] == 'TOGGLE':
            return self.switch(switch, state = 'on' if state == '1' else 'off')
        else:
            return {'debug': f'Device event {event} not recognized'}

    def listener_gesture(self, event, time, fingers, x, y, x2, y2, ratio, angle, cancelled):
        'Listener for GESTURE lines'
        fingers = int(fingers)

        if event[0] == 'HOLD':
            return self.hold('gesture', event[1], time, fingers, cancelled)
        elif event[1] == 'BEGIN':
            return self.begin('gesture', event[0], time, fingers)
        elif event[1] == 'UPDATE':
            return self.update(time, fingers, x, y, ratio, angle)
        elif event[1] == 'END':
            return self.end(cancelled)
        else:
            return {'debug': f'Device event {event} not recognized'}

    def listener_pointer(self, event, time, x, y, button, state, vert, horiz):
        'Listener for POINTER lines'
        if event[0] == 'SCROLL' and event[1] == 'FINGER':
