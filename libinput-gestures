class ACTIONS:
    'Singleton class for storing actions'

    # Configurable actions and how to parse them
    available = dict(switch = {'toggle'   : ('tablet-mode', 'lid', 'keypad-slide'),
                               'state'    : ('on', 'off'),
                               'command'  : '.*'},
                     swipe =  {'motion'   : ('up', 'down', 'left', 'right'),
                               'fingers' : r'\d',
                               'modifier?': ('pre', 'chain', 'continuous', 'end', 'post'),
                               'command'  : r'[^\[\]]+',
                               'wclass?'   : r'\[.*\]'},
                     pinch =  {'motion'   : ('in', 'out'),
                               'fingers' : r'\d',
                               'modifier?': ('pre', 'chain', 'continuous', 'end', 'post'),
                               'command'  : r'[^\[\]]+',
                               'wclass?'   : r'\[.*\]'},
                     rotate = {'motion'   : ('cw', 'ccw'),
                               'fingers' : r'\d',
                               'modifier?': ('pre', 'chain', 'continuous', 'end', 'post'),
                               'command'  : r'[^\[\]]+',
                               'wclass?'   : r'\[.*\]'},
                     hold =   {'fingers' : r'\d',
                               'modifier?': ('pre', 'end'),
                               'command'  : r'[^\[\]]+',
                               'wclass?'   : r'\[.*\]'})

    conf_re = {}
    actions = {}
    parsed_actions = []

    def __init__(self):
        'Build parsing regexes from dict'
        for action, params in self.available.items():
            verbs = []
            for verb, arg in params.items():
                arg = '|'.join(arg) if type(arg).__name__ != "str" else arg
                if verb[-1] == "?":
                    verbs.append(rf"""(?P<{verb[:-1]}>{arg})?""")
                else:
                    verbs.append(rf"""(?P<{verb}>{arg})""")
            self.conf_re[action] = re.compile(rf"""\s*""".join(verbs))

    def parse(self, restrict, action, args):
        'Parse a conf line with the action regexes'
        fields = self.conf_re[action].match(args)

        if not fields:
            return f'Could not parse {action} line'

        fields = fields.groupdict()

        if action == 'switch':
            self.add_switch(**fields)
        else:
            self.add(restrict, action, **fields)

    def add_switch(self, toggle, state, command):
        'Add a switch action'
        self.parsed_actions.append(f'switch {toggle:12} {state:3} {command}')
        self.build_path('switch', toggle, state, command = command)

    def add(self, restrict, action, fingers, wclass, modifier, command, motion = None):
        'Add all other actions'
        fingers = int(fingers)
        modifier = modifier or 'end'

        self.parsed_actions.append(f'{restrict or '':7} {action:6} {fingers} {motion:5} {modifier:10} {command:60} {wclass or '':>}')

        wclass = wclass and wclass[1:-1]
        restrict = [restrict] if restrict else ['touch', 'gesture']

        for r in restrict:
            self.build_path(r, fingers, action, motion, wclass, modifier, command = command)

            if not self.actions[r][fingers][action].get('apps'):
                self.actions[r][fingers][action]['apps'] = set()

            self.actions[r][fingers][action]['apps'].add(wclass)

    def build_path(self, *args, command):
        'Construct the actions dict object up to the given path'
        current = self.actions

        for arg in args[:-1]:
            if not current.get(arg):
                current[arg] = {}
            current = current[arg]

        current[args[-1]] = command

    def validate_path(self, path):
        'Return the first path item not matching, or the resulting action path'
        current = self.actions
        for item in path:
           current = current.get(item)
           if not current:
               return (False, item)

        return (True, current)

    def __str__(self):
        return '\n'.join(sorted(self.parsed_actions))

    instance = None

    def __new__(cls):
        'Ensure single instance'
        if cls.instance is None:
            cls.instance = super().__new__(cls)
            return cls.instance

