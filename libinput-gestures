        ((?P<x> \d+\.\d+) /\s* (?P<y> \d+\.\d+))? # Absolute position 0-100% of width/height
    """, flags = re.VERBOSE),

    GESTURE = re.compile(r"""
        (?P<fingers> \d)                                                                    # Fingers
        \s*
        (?P<cancelled>cancelled)?
        \s*
        ((?P<x> -? \d+\.\d+) \s* / \s* (?P<y> -? \d+\.\d+))?                                # Absolute position 0-100% of width/height
        \s*
        ( \( \s* (?P<x2> -? \d+\.\d+) \s* / \s* (?P<y2> -? \d+\.\d+) \s* unaccelerated\) )? # Absolute position 0-100% of width/height
        \s*
        ((?P<ratio> \d+\.\d+) \s* @ \s* (?P<angle> -? \d+\.\d+))?
    """, flags = re.VERBOSE),

    POINTER = re.compile(r"""
        ((?P<x> -? \d+\.\d+) \s* / \s* (?P<y> -? \d+\.\d+))?
