def main():
    # Set up command line arguments
    get_options()

    # Output various info/version info
    if args.verbose:
        xsession = os.getenv('XDG_SESSION_DESKTOP') or os.getenv('DESKTOP_SESSION') or 'unknown'
        xtype = os.getenv('XDG_SESSION_TYPE') or 'unknown'
        print(f'{PROGNAME}: session {xsession}+{xtype} on {platform.platform()}, python {platform.python_version()}')

    # Read and process the conf file
    read_conf(args.conffile, CONFNAME)

    # Listen to libinput debug-events
    cmd = listen_libinput()

    handler = {}

    if args.verbose:
        print('LIBINPUT:')

    # Sit in a loop forever reading the libinput messages.
    for line in cmd.stdout:
        line = line.strip()

        # Parse libinput output
        fields = params_re['LIBINPUT'].match(line)

        # Something very wrong with libinput output has happened
        if not fields:
            sys.exit(f'Error parsing libinput line: {line}')

        device, event, time, params = fields.groupdict().values()

        if args.raw:
            print(f'Raw libinput line: {line}')
            print(f'Parsed libinput line: {device=} {event=} {time=}')

        # Create a handler for every device
        if not handler.get(device):
            handler[device] = HANDLER(device)

        # Pass the event and params to the handler
        handler[device].parse(event, time, params)

        if args.raw:
            print()

if __name__ == '__main__':
    main()
