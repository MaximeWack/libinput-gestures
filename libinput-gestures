        (?P<event> [A-Z_]+)                    # Event
        \s*
        (?:\d+)?                               # Event number within frame
        \s*
        (\+ (?P<time> \d+\.\d+) s)?            # Time
        \s*
        (?P<params> .*)?                       # Params
    """, flags = re.VERBOSE),

    DEVICE = re.compile(r"""
        (?P<name>.*?)
        \s*
        (?P<seat>seat\d \s default)
        \s*
        (?P<group>group\d+)
        \s*
        (cap:(?P<capabilities>[kpgStT]+))
        \s*
        (size \s (?P<sizex>\d+) x (?P<sizey>\d+) mm)?
    """, flags = re.VERBOSE),

    SWITCH = re.compile(r"""
        switch
        \s+
        (?P<switch> tablet-mode | lid | keypad-slide) # Switch name
        \s*
